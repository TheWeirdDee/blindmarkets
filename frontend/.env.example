# --- Backend Gateway ---
# URL of the running gateway service (server-side only, not exposed to the browser)
GATEWAY_URL=http://localhost:3000
GATEWAY_API_KEY_HEADER=X-API-KEY
GATEWAY_API_KEY=your-api-key-here

# --- Starknet ---
# RPC endpoint for the chain you are targeting
NEXT_PUBLIC_STARKNET_RPC_URL=https://starknet-mainnet.infura.io/v3/YOUR_KEY
# Mainnet: 0x534e5f4d41494e  |  Sepolia: 0x534e5f5345504f4c4941
NEXT_PUBLIC_STARKNET_CHAIN_ID=0x534e5f4d41494e
# Address of the deployed IntentRegistry contract — must be non-zero before any intent can commit
NEXT_PUBLIC_INTENT_REGISTRY_ADDRESS=0xYOUR_INTENT_REGISTRY_ADDRESS

# --- Batch parameters (must match gateway and coordinator config exactly) ---
NEXT_PUBLIC_BATCH_WINDOW_SECONDS=30
# Unix timestamp of the first batch window — set this to the block timestamp at contract deployment
NEXT_PUBLIC_GENESIS_TIMESTAMP=1700000000

# --- Default form values (optional, pre-fills the intent composer) ---
# Token contract addresses on the deployed chain
NEXT_PUBLIC_DEFAULT_ASSET_IN=0xYOUR_BTC_WRAPPER_ADDRESS
NEXT_PUBLIC_DEFAULT_ASSET_OUT=0xYOUR_USDC_ADDRESS
NEXT_PUBLIC_DEFAULT_AMOUNT=
NEXT_PUBLIC_DEFAULT_MIN_OUTPUT=
NEXT_PUBLIC_DEFAULT_MAX_FEE_BPS=50
NEXT_PUBLIC_MAX_INTENT_DEADLINE_SECONDS=120
NEXT_PUBLIC_DEFAULT_DEADLINE_MINUTES=2
NEXT_PUBLIC_DEFAULT_PRIVACY_MODE=public

# --- Risk disclosure panel (optional, shown in the UI) ---
NEXT_PUBLIC_BRIDGE_RISK=
NEXT_PUBLIC_CUSTODY_MODEL=
NEXT_PUBLIC_SETTLEMENT_TIME=
NEXT_PUBLIC_SETTLEMENT_NOTE=
# Link to published audit report — leave empty to hide the link
NEXT_PUBLIC_AUDIT_REPORTS_URL=
