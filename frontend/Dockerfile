FROM node:20-bookworm-slim AS deps

WORKDIR /app

COPY frontend/package.json frontend/package-lock.json ./

RUN npm ci

FROM node:20-bookworm-slim AS builder

WORKDIR /app

COPY --from=deps /app/node_modules ./node_modules
COPY frontend ./

ARG NEXT_PUBLIC_STARKNET_RPC_URL
ARG NEXT_PUBLIC_STARKNET_CHAIN_ID
ARG NEXT_PUBLIC_INTENT_REGISTRY_ADDRESS
ARG NEXT_PUBLIC_BATCH_WINDOW_SECONDS
ARG NEXT_PUBLIC_GENESIS_TIMESTAMP
ARG NEXT_PUBLIC_DEFAULT_ASSET_IN
ARG NEXT_PUBLIC_DEFAULT_ASSET_OUT
ARG NEXT_PUBLIC_DEFAULT_AMOUNT
ARG NEXT_PUBLIC_DEFAULT_MIN_OUTPUT
ARG NEXT_PUBLIC_DEFAULT_MAX_FEE_BPS
ARG NEXT_PUBLIC_DEFAULT_DEADLINE_MINUTES
ARG NEXT_PUBLIC_DEFAULT_PRIVACY_MODE
ARG NEXT_PUBLIC_BRIDGE_RISK
ARG NEXT_PUBLIC_CUSTODY_MODEL
ARG NEXT_PUBLIC_SETTLEMENT_TIME
ARG NEXT_PUBLIC_SETTLEMENT_NOTE
ARG NEXT_PUBLIC_AUDIT_REPORTS_URL

ENV NEXT_PUBLIC_STARKNET_RPC_URL="${NEXT_PUBLIC_STARKNET_RPC_URL}" \
    NEXT_PUBLIC_STARKNET_CHAIN_ID="${NEXT_PUBLIC_STARKNET_CHAIN_ID}" \
    NEXT_PUBLIC_INTENT_REGISTRY_ADDRESS="${NEXT_PUBLIC_INTENT_REGISTRY_ADDRESS}" \
    NEXT_PUBLIC_BATCH_WINDOW_SECONDS="${NEXT_PUBLIC_BATCH_WINDOW_SECONDS}" \
    NEXT_PUBLIC_GENESIS_TIMESTAMP="${NEXT_PUBLIC_GENESIS_TIMESTAMP}" \
    NEXT_PUBLIC_DEFAULT_ASSET_IN="${NEXT_PUBLIC_DEFAULT_ASSET_IN}" \
    NEXT_PUBLIC_DEFAULT_ASSET_OUT="${NEXT_PUBLIC_DEFAULT_ASSET_OUT}" \
    NEXT_PUBLIC_DEFAULT_AMOUNT="${NEXT_PUBLIC_DEFAULT_AMOUNT}" \
    NEXT_PUBLIC_DEFAULT_MIN_OUTPUT="${NEXT_PUBLIC_DEFAULT_MIN_OUTPUT}" \
    NEXT_PUBLIC_DEFAULT_MAX_FEE_BPS="${NEXT_PUBLIC_DEFAULT_MAX_FEE_BPS}" \
    NEXT_PUBLIC_DEFAULT_DEADLINE_MINUTES="${NEXT_PUBLIC_DEFAULT_DEADLINE_MINUTES}" \
    NEXT_PUBLIC_DEFAULT_PRIVACY_MODE="${NEXT_PUBLIC_DEFAULT_PRIVACY_MODE}" \
    NEXT_PUBLIC_BRIDGE_RISK="${NEXT_PUBLIC_BRIDGE_RISK}" \
    NEXT_PUBLIC_CUSTODY_MODEL="${NEXT_PUBLIC_CUSTODY_MODEL}" \
    NEXT_PUBLIC_SETTLEMENT_TIME="${NEXT_PUBLIC_SETTLEMENT_TIME}" \
    NEXT_PUBLIC_SETTLEMENT_NOTE="${NEXT_PUBLIC_SETTLEMENT_NOTE}" \
    NEXT_PUBLIC_AUDIT_REPORTS_URL="${NEXT_PUBLIC_AUDIT_REPORTS_URL}"

RUN npm run build

FROM node:20-bookworm-slim AS runtime

WORKDIR /app

ENV NODE_ENV=production \
    PORT=3001 \
    HOSTNAME=0.0.0.0

COPY --from=builder /app/.next/standalone ./
COPY --from=builder /app/.next/static ./.next/static
COPY --from=builder /app/public ./public

EXPOSE 3001

CMD ["node", "server.js"]
