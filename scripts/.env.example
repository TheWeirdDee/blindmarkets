# Blind BTC Intent Markets - Deployment Configuration
# Copy this file to .env and fill in your values

# Starknet Configuration
STARKNET_RPC_URL=https://starknet-goerli.g.alchemy.com/v2/YOUR_API_KEY
STARKNET_CHAIN_ID=SN_GOERLI

# Deployer Account
DEPLOYER_PRIVATE_KEY=0xYOUR_PRIVATE_KEY
DEPLOYER_ADDRESS=0xYOUR_ACCOUNT_ADDRESS

# Admin Configuration
ADMIN_ADDRESS=0xYOUR_ADMIN_ADDRESS

# Treasury Configuration
TREASURY_ADDRESS=0xYOUR_TREASURY_ADDRESS

# Coordinator Configuration
COORDINATOR_ADDRESS=0xYOUR_COORDINATOR_ADDRESS

# Bond Token (e.g., SBTC address on Starknet)
BOND_TOKEN_ADDRESS=0xBOND_TOKEN_ADDRESS
