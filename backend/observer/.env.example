STARKNET_RPC_URL=https://starknet-mainnet.infura.io/v3/YOUR_KEY
OBSERVER_POLL_INTERVAL_SECONDS=10
OBSERVER_FROM_BLOCK=0
# Comma-separated deployed contract addresses to watch (batch_auction and batch_settlement).
OBSERVER_CONTRACT_ADDRESSES=0xBATCH_AUCTION_ADDRESS,0xBATCH_SETTLEMENT_ADDRESS

GATEWAY_URL=http://localhost:3000
GATEWAY_API_KEY_HEADER=X-API-KEY
GATEWAY_API_KEY=your-api-key-here

# Event selector keys — starknet_keccak(event_name), 250-bit truncated.
# These are derived from the Cairo contract event names and do not change
# unless the event structs in the contracts are renamed.
OBSERVER_SETTLEMENT_EVENT_KEY=0x1eb4ef5f1d338149bcb267c5e66c135d95cfdb10c22246ab1b0e62cc7c22f27
OBSERVER_SETTLEMENT_BATCH_ID_INDEX=0

OBSERVER_FAILURE_EVENT_KEY=0x36574503274deea641e925355a0cc27964b51dfb3ab601caa4fa5155d128c36
OBSERVER_FAILURE_BATCH_ID_INDEX=0
OBSERVER_FAILURE_REASON_INDEX=1

OBSERVER_INTENT_COMMIT_EVENT_KEY=0x336b9cc0c2835595b555b6275e11a8e30e2a7cce59654f8826f5e8571a39ce4
OBSERVER_INTENT_COMMIT_INTENT_ID_INDEX=0
OBSERVER_INTENT_COMMIT_USER_INDEX=3

OBSERVER_INTENT_CANCEL_EVENT_KEY=0x1d6ce1246fa9eced082e7b8c40d65e50c96fdc1b409fc9ebb282f763fa533c2
OBSERVER_INTENT_CANCEL_INTENT_ID_INDEX=0
OBSERVER_INTENT_CANCEL_USER_INDEX=2

OBSERVER_CHECKPOINT_PATH=/tmp/blindmarkets_observer.checkpoint
