STARKNET_RPC_URL=https://starknet-mainnet.example/rpc
OBSERVER_POLL_INTERVAL_SECONDS=10
OBSERVER_FROM_BLOCK=0
OBSERVER_CONTRACT_ADDRESSES=0x0

GATEWAY_URL=http://localhost:3000
GATEWAY_API_KEY_HEADER=X-API-KEY
GATEWAY_API_KEY=replace_me

OBSERVER_SETTLEMENT_EVENT_KEY=0x0
OBSERVER_SETTLEMENT_BATCH_ID_INDEX=0
OBSERVER_FAILURE_EVENT_KEY=0x0
OBSERVER_FAILURE_BATCH_ID_INDEX=0
OBSERVER_FAILURE_REASON_INDEX=1

OBSERVER_CHECKPOINT_PATH=/tmp/blindmarkets_observer.checkpoint
