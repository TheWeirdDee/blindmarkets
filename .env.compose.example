# Infrastructure
POSTGRES_USER=blindmarkets
POSTGRES_PASSWORD=blindmarkets_dev_password
POSTGRES_DB=blindmarkets

# Gateway API auth shared by frontend, coordinator, observer, and solver
GATEWAY_API_KEY_HEADER=X-API-KEY
GATEWAY_API_KEY=your-api-key-here

# Shared Starknet configuration
STARKNET_RPC_URL=https://starknet-mainnet.example/rpc
STARKNET_CHAIN_ID=0x534e5f4d41494e
INTENT_REGISTRY_ADDRESS=0x0
BATCH_AUCTION_ADDRESS=0x0
BATCH_SETTLEMENT_ADDRESS=0x0
SOLVER_BOND_ADDRESS=0x0

# Gateway service
WEBSOCKET_CHANNEL_CAPACITY=1000
MAX_PAGE_SIZE=100
DATABASE_MAX_CONNECTIONS=10
REDIS_MAX_CONNECTIONS=10
MAX_INTENTS_PER_USER_PER_MINUTE=60
MAX_REQUESTS_PER_IP_PER_MINUTE=600
RATE_LIMIT_WINDOW_SECONDS=60
BATCH_WINDOW_SECONDS=30
GENESIS_TIMESTAMP=1700000000
EXECUTION_DELAY_SECONDS=15
INTENT_DEADLINE_SECONDS=120
GATEWAY_ACCOUNT_ADDRESS=0x0
GATEWAY_ACCOUNT_PRIVATE_KEY=0x0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
GATEWAY_PRIVATE_KEY=0x0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
CORS_ALLOWED_ORIGINS=http://localhost:3001
LOG_LEVEL=info
LOG_FORMAT=json

# Coordinator
